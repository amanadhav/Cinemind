# Byte-compiled / optimized files
__pycache__/
*.py[cod]
*$py.class

# Environments
.env
.venv/
venv/
env/
ENV/

# Test / tooling caches
.pytest_cache/
.coverage
htmlcov/

# OS files
.DS_Store

# CSV outputs (keep curated datasets under data/)
*.csv
!data/**/*.csv

# ML-25M ratings file is 646MB — exceeds GitHub's 100MB limit and the
# MovieLens license prohibits redistribution. Download ml-25m separately
# and place ratings.csv here (see README). The compressed .gz is also
# excluded; production uses the small precomputed data/processed/svd_model.npz
# (generated by build_svd_model.py) instead of the raw ratings.
data/raw/ratings.csv
data/raw/ratings.csv.gz
